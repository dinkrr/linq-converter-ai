### Variables
@baseUrl = http://localhost:5037
@apiVersion = v1

### Health Check
GET {{baseUrl}}/api/health
Accept: application/json

###

### Get Configuration (Debug)
GET {{baseUrl}}/api/debug/config
Accept: application/json

###

### Test Simple C# to LINQ Conversion
POST {{baseUrl}}/api/codeconversion/convert
Content-Type: application/json

{
    "csharpCode": "List<int> numbers = new List<int> {1,2,3,4,5}; List<int> evens = new List<int>(); foreach(int num in numbers) { if(num % 2 == 0) evens.Add(num); }",
    "includeExplanation": true,
    "optimizeForPerformance": true,
    "includeComments": true
}

###

### Test Complex C# to LINQ Conversion
POST {{baseUrl}}/api/codeconversion/convert
Content-Type: application/json

{
    "csharpCode": "List<Product> products = GetProducts(); List<Product> expensiveProducts = new List<Product>(); foreach(Product p in products) { if(p.Price > 100 && p.Category == \"Electronics\") { expensiveProducts.Add(p); } }",
    "includeExplanation": true,
    "optimizeForPerformance": false,
    "includeComments": false
}

###

### Test Nested Loop Conversion
POST {{baseUrl}}/api/codeconversion/convert
Content-Type: application/json

{
    "csharpCode": "List<Order> orders = GetOrders(); List<OrderItem> items = new List<OrderItem>(); foreach(Order order in orders) { foreach(OrderItem item in order.Items) { if(item.Quantity > 1) { items.Add(item); } } }",
    "includeExplanation": true,
    "optimizeForPerformance": true,
    "includeComments": true
}

###

### Test Code Explanation
POST {{baseUrl}}/api/codeconversion/explain
Content-Type: application/json

{
    "csharpCode": "for(int i = 0; i < items.Count; i++) { if(items[i].IsActive) { ProcessItem(items[i]); } }",
    "includeLinqEquivalent": true
}

