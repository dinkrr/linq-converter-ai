### Test Large Code Block
POST {{baseUrl}}/api/codeconversion/convert
Content-Type: application/json

{
    "csharpCode": "public class DataProcessor { public List<ProcessedData> ProcessItems(List<RawData> rawItems) { List<ProcessedData> processedItems = new List<ProcessedData>(); foreach(RawData raw in rawItems) { if(raw.IsValid && raw.Timestamp > DateTime.Now.AddDays(-30)) { ProcessedData processed = new ProcessedData(); processed.Id = raw.Id; processed.Value = raw.Value * 1.1; processed.Category = raw.Category.ToUpper(); processedItems.Add(processed); } } return processedItems; } }",
    "includeExplanation": true,
    "optimizeForPerformance": true,
    "includeComments": true
}

